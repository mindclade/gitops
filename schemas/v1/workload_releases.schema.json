{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.io/schemas/gitops/v1/workload_releases.schema.json",
  "title": "Workload release set",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "active", "releaseClass", "releases"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "environment": {"enum": ["development", "staging", "production", "restricted"]},
    "active": {"type": "boolean"},
    "releaseClass": {"enum": ["service", "worker"]},
    "releases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["component", "cluster", "namespace", "artifact", "digest", "priorDigest", "sourceRevision", "desiredStateRevision", "desiredStatePath", "releaseRecordDigest", "promotionReceiptDigest", "governanceEvidenceDigest", "configurationDigest", "evidence", "rollout"],
        "properties": {
          "component": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{1,61}[a-z0-9])$"},
          "cluster": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{1,61}[a-z0-9])$"},
          "namespace": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$"},
          "artifact": {"type": "string", "pattern": "^\\S+@sha256:[0-9a-f]{64}$"},
          "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "priorDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "desiredStateRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "desiredStatePath": {"type": "string", "pattern": "^environments/(development|staging|production|restricted)/(services|workers)/[a-z](?:[a-z0-9-]{1,61}[a-z0-9])$"},
          "releaseRecordDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "promotionReceiptDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "governanceEvidenceDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "configurationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["signature", "sbom", "provenance", "vulnerabilityScan", "evaluation", "signer", "issuer"],
            "properties": {
              "signature": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "sbom": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "provenance": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "vulnerabilityScan": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "evaluation": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
              "signer": {"type": "string", "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"},
              "issuer": {"type": "string", "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"}
            }
          },
          "rollout": {
            "type": "object",
            "additionalProperties": false,
            "required": ["strategy", "initialPercent", "automaticPromotion"],
            "properties": {
              "strategy": {"enum": ["manual", "canary", "blue-green"]},
              "initialPercent": {"type": "integer", "minimum": 0, "maximum": 25},
              "automaticPromotion": {"const": false}
            }
          }
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"active": {"const": true}}}, "then": {"properties": {"releases": {"minItems": 1}}}},
    {"if": {"properties": {"active": {"const": false}}}, "then": {"properties": {"releases": {"maxItems": 0}}}}
  ]
}
