{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.io/schemas/gitops/v1/promotion_receipt.schema.json",
  "title": "Promotion or rollback receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "action", "environment", "releaseClass", "component", "cluster", "sourceRevision", "artifactReference", "artifactDigest", "priorDigest", "attestationDigest", "signer", "issuer", "issuedAt", "approvals", "repository", "workflowRunID", "workflowRunAttempt", "checkedOutRevision", "requester"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "action": {"enum": ["promote", "rollback"]},
    "environment": {"enum": ["development", "staging", "production", "restricted"]},
    "releaseClass": {"enum": ["platform", "service", "worker"]},
    "component": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{1,61}[a-z0-9])$"},
    "cluster": {"type": "string", "pattern": "^[a-z](?:[a-z0-9-]{1,61}[a-z0-9])$"},
    "sourceRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "artifactReference": {"type": "string", "pattern": "^\\S+@sha256:[0-9a-f]{64}$"},
    "artifactDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "priorDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "attestationDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signer": {"type": "string", "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"},
    "issuer": {"type": "string", "pattern": "^https://[^/?#@\\s]+(?:/[^?#\\s]*)?$"},
    "issuedAt": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},
    "approvals": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 3, "maxLength": 256}},
    "repository": {"const": "mindclade/gitops"},
    "workflowRunID": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "workflowRunAttempt": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "checkedOutRevision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "requester": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-\\[\\]]{0,127}$"}
  }
}
