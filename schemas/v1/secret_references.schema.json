{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mindclade.io/schemas/gitops/v1/secret_references.schema.json",
  "title": "External secret references",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "environment", "active", "references"],
  "properties": {
    "schemaVersion": {"const": "v1"},
    "environment": {"enum": ["development", "staging", "production", "restricted"]},
    "active": {"type": "boolean"},
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "namespace", "externalSecret", "storeRef", "purpose"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
          "namespace": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
          "externalSecret": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
          "storeRef": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,62}$"},
          "purpose": {"type": "string", "minLength": 8, "maxLength": 256}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"active": {"const": true}}}, "then": {"properties": {"references": {"minItems": 1}}}},
    {"if": {"properties": {"active": {"const": false}}}, "then": {"properties": {"references": {"maxItems": 0}}}}
  ]
}
