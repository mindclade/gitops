module(
    name = "mindclade_gitops",
    version = "0.1.0",
    bazel_compatibility = [
        ">=9.1.1",
        "<=9.1.1",
    ],
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "platforms", version = "1.1.0")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")

# Dependabot stages nested files by matching *_from_file assignments in the
# raw module text before regenerating MODULE.bazel.lock. Keep both literals.
go_mod_from_file = "//tooling:go.mod"

# Dependabot staging hint: go_sum_from_file = "//tooling:go.sum"

go_deps.from_file(go_mod = go_mod_from_file)
use_repo(
    go_deps,
    "com_github_santhosh_tekuri_jsonschema_v5",
    "in_gopkg_yaml_v3",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.host(
    name = "go_sdk",
    version = "1.26.7",
)
use_repo(go_sdk, "go_sdk")

local_runtime_repo = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_repo",
)

local_runtime_toolchains_repo = use_repo_rule(
    "@rules_python//python/local_toolchains:repos.bzl",
    "local_runtime_toolchains_repo",
)

local_runtime_repo(
    name = "nix_python_3_12",
    interpreter_path = "python3",
    on_failure = "fail",
)

local_runtime_toolchains_repo(
    name = "nix_python_toolchains",
    runtimes = ["nix_python_3_12"],
)

register_toolchains("@nix_python_toolchains//:all")
