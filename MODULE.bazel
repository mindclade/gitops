module(
    name = "mindclade_gitops",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "rules_python", version = "2.3.2")
bazel_dep(name = "gazelle", version = "0.51.3")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//tooling:go.mod")
use_repo(
    go_deps,
    "com_github_santhosh_tekuri_jsonschema_v5",
    "in_gopkg_yaml_v3",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(
    name = "go_sdk",
    version = "1.26.6",
)
use_repo(go_sdk, "go_sdk")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.12.12")
use_repo(python, "python_3_12_12")
